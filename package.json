{
  "name": "gitblame",
  "displayName": "Git Blame",
  "description": "See git blame information in the status bar or in-line.",
  "version": "14.0.0",
  "publisher": "waderyan",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": ">=1.138.0",
    "node": ">=24.19.0"
  },
  "main": "./out/index.js",
  "l10n": "./translations",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsx esbuild.mts",
    "build-with-sourcemaps": "SOURCEMAPS=1 tsx esbuild.mts",
    "package": "npx @vscode/vsce package",
    "lint": "biome lint ./src ./test --write",
    "check": "biome check ./src ./test --write",
    "update-test-snapshots": "tsx --test --experimental-test-module-mocks --test-update-snapshots \"./**/*.test.ts\"",
    "test-coverage": "tsx --test --experimental-test-module-mocks --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=./lcov.info  \"./**/*.test.ts\"",
    "test": "tsx --test --experimental-test-module-mocks \"./**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "@types/vscode": "1.138.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/Sertion/vscode-gitblame/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/Sertion/vscode-gitblame/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sertion/vscode-gitblame"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "gitblame",
    "blame",
    "codeberg",
    "github",
    "gitlab",
    "bitbucket"
  ],
  "icon": "images/git_icon_3d.png",
  "activationEvents": [
    "onEditSession:file",
    "onFileSystem:file",
    "workspaceContains:**/.git/HEAD"
  ],
  "qna": false,
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git Blame (extension) executes command line tools in the workspace"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "gitblame.quickInfo",
        "title": "%gitblame.command.quickInfo%"
      },
      {
        "command": "gitblame.online",
        "title": "%gitblame.command.online%"
      },
      {
        "command": "gitblame.addCommitHashToClipboard",
        "title": "%gitblame.command.addCommitHashToClipboard%"
      },
      {
        "command": "gitblame.addToolUrlToClipboard",
        "title": "%gitblame.command.addToolUrlToClipboard%"
      },
      {
        "command": "gitblame.gitShow",
        "title": "%gitblame.command.gitShow%"
      }
    ],
    "colors": [
      {
        "id": "gitblame.inlineMessage",
        "description": "%gitblame.colors.inlineMessage.description%",
        "defaults": {
          "dark": "editorCodeLens.foreground",
          "light": "editorCodeLens.foreground",
          "highContrast": "editorCodeLens.foreground",
          "highContrastLight": "editorCodeLens.foreground"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%gitblame.configuration.title%",
      "properties": {
        "gitblame.infoMessageFormat": {
          "type": "string",
          "default": "${commit.summary}",
          "scope": "resource",
          "description": "%gitblame.properties.infoMessageFormat.description%"
        },
        "gitblame.statusBarMessageClickAction": {
          "type": "string",
          "default": "SHOW_MESSAGE",
          "scope": "resource",
          "enum": [
            "SHOW_MESSAGE",
            "OPEN_URL",
            "GIT_SHOW",
            "COPY_HASH"
          ],
          "enumItemLabels": [
            "%gitblame.properties.statusBarMessageClickAction.enum.label.message%",
            "%gitblame.properties.statusBarMessageClickAction.enum.label.tool%",
            "%gitblame.properties.statusBarMessageClickAction.enum.label.gitshow%",
            "%gitblame.properties.statusBarMessageClickAction.enum.label.copy%"
          ],
          "enumDescriptions": [
            "%gitblame.properties.statusBarMessageClickAction.enum.description.message%",
            "%gitblame.properties.statusBarMessageClickAction.enum.description.tool%",
            "%gitblame.properties.statusBarMessageClickAction.enum.description.gitshow%",
            "%gitblame.properties.statusBarMessageClickAction.enum.description.copy%"
          ]
        },
        "gitblame.statusBarMessageFormat": {
          "type": "string",
          "default": "Blame ${author.name} (${time.ago})",
          "scope": "resource",
          "description": "%gitblame.properties.statusBarMessageFormat.description%"
        },
        "gitblame.statusBarMessageNoCommit": {
          "type": "string",
          "default": "Not Committed Yet",
          "scope": "resource",
          "description": "%gitblame.properties.statusBarMessageNoCommit.description%"
        },
        "gitblame.statusBarPositionPriority": {
          "type": "number",
          "default": 500,
          "scope": "resource",
          "description": "%gitblame.properties.statusBarPositionPriority.description%"
        },
        "gitblame.inlineMessageEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "%gitblame.properties.inlineMessageEnabled.description%"
        },
        "gitblame.inlineMessageFormat": {
          "type": "string",
          "default": "Blame ${author.name} (${time.ago})",
          "scope": "resource",
          "description": "%gitblame.properties.inlineMessageFormat.description%"
        },
        "gitblame.inlineMessageNoCommit": {
          "type": "string",
          "default": "Not Committed Yet",
          "scope": "resource",
          "description": "%gitblame.properties.inlineMessageNoCommit.description%"
        },
        "gitblame.inlineMessageMargin": {
          "type": "number",
          "default": 2,
          "scope": "resource",
          "description": "%gitblame.properties.inlineMessageMargin.description%"
        },
        "gitblame.currentUserAlias": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.currentUserAlias.markdownDescription%"
        },
        "gitblame.remoteName": {
          "type": "string",
          "default": "origin",
          "scope": "resource",
          "description": "%gitblame.properties.remoteName.description%"
        },
        "gitblame.commitUrl": {
          "type": "string",
          "default": "${tool.protocol}//${gitorigin.hostname}${gitorigin.port}${gitorigin.path}${tool.commitpath}${hash}",
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.commitUrl.markdownDescription%"
        },
        "gitblame.commitUrl.perHostnameOverride": {
          "type": "object",
          "default": {
            "ssh.dev.azure.com": "https://dev.azure.com/${gitorigin.path,1}/${gitorigin.path,2}/_git/${gitorigin.path,3}/commit/${hash}"
          },
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.commitUrl.perHostnameOverride.markdownDescription%"
        },
        "gitblame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.ignoreWhitespace.markdownDescription%"
        },
        "gitblame.pluralWebPathSubstrings": {
          "type": "array",
          "default": [
            "bitbucket",
            "atlassian"
          ],
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.pluralWebPathSubstrings.markdownDescription%"
        },
        "gitblame.delayBlame": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "description": "%gitblame.properties.delayBlame.description%"
        },
        "gitblame.parallelBlames": {
          "type": "number",
          "minimum": 1,
          "default": 2,
          "scope": "resource",
          "description": "%gitblame.properties.parallelBlames.description%"
        },
        "gitblame.maxLineCount": {
          "type": "number",
          "default": 16384,
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.maxLineCount.markdownDescription%"
        },
        "gitblame.revsFile": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.revsFile.markdownDescription%"
        },
        "gitblame.extendedHoverInformation": {
          "type": "string",
          "default": "off",
          "scope": "resource",
          "enum": [
            "off",
            "inline-status",
            "inline",
            "status"
          ],
          "enumItemLabels": [
            "%gitblame.properties.extendedHoverInformation.enum.label.off%",
            "%gitblame.properties.extendedHoverInformation.enum.label.inline-status%",
            "%gitblame.properties.extendedHoverInformation.enum.label.inline%",
            "%gitblame.properties.extendedHoverInformation.enum.label.status%"
          ],
          "enumDescriptions": [
            "%gitblame.properties.extendedHoverInformation.enum.description.off%",
            "%gitblame.properties.extendedHoverInformation.enum.description.inline-status%",
            "%gitblame.properties.extendedHoverInformation.enum.description.inline%",
            "%gitblame.properties.extendedHoverInformation.enum.description.status%"
          ]
        },
        "gitblame.detectMoveOrCopyFromOtherFiles": {
          "type": "number",
          "default": 0,
          "scope": "resource",
          "markdownDescription": "%gitblame.properties.detectMoveOrCopyFromOtherFiles.markdownDescription%",
          "enum": [
            0,
            1,
            2,
            3
          ],
          "enumItemLabels": [
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.label.0%",
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.label.1%",
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.label.2%",
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.label.3%"
          ],
          "enumDescriptions": [
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.description.0%",
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.description.1%",
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.description.2%",
            "%gitblame.properties.detectMoveOrCopyFromOtherFiles.enum.description.3%"
          ]
        }
      }
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
